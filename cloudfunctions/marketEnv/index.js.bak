/**
 * 大盘环境云函数 - 快速并行获取
 * 优化: sina行情 + 腾讯K线 并行获取，2秒内返回
 */
const cloud = require('wx-server-sdk')
cloud.init({ env: cloud.DYNAMIC_CURRENT_ENV })
const http = require('./http')

function withTimeout(promiseFactory, ms, fallback = null) {
  return new Promise((resolve) => {
    let done = false
    const timer = setTimeout(() => { if (!done) { done = true; resolve(fallback) } }, ms)
    promiseFactory().then(v => { if (!done) { done = true; clearTimeout(timer); resolve(v) } })
      .catch(() => { if (!done) { done = true; clearTimeout(timer); resolve(fallback) } })
  })
}

/**
 * 获取沪深300行情 (主源: 新浪)
 */
async function getIndexQuote() {
  return withTimeout(async () => {
    const text = await http.request('https://hq.sinajs.cn/list=sh000300', {
      timeout: 2000,
      headers: { 'User-Agent': 'Mozilla/5.0', 'Referer': 'https://finance.sina.com.cn/' }
    })
    const match = text.match(/"([^"]+)"/)
    if (!match) return null
    const parts = match[1].split(',')
    if (parts.length < 5) return null
    const prevClose = parseFloat(parts[2]) || 0
    const current = parseFloat(parts[3]) || 0
    if (prevClose <= 0) return null
    const changePct = Math.round((current - prevClose) / prevClose * 10000) / 100

    let status
    if (changePct > 2) status = '大涨'
    else if (changePct > 0.5) status = '上涨'
    else if (changePct > -0.5) status = '震荡'
    else if (changePct > -2) status = '下跌'
    else status = '大跌'

    return { status, changePct, current, prevClose }
  }, 2000, null)
}

/**
 * 获取沪深300趋势 (备用源: 腾讯K线)
 */
async function getIndexTrend() {
  return withTimeout(async () => {
    const klineText = await http.request('https://web.ifzq.gtimg.cn/appstock/app/fqkline/get?param=sz399300,day,,,30,qfq', {
      timeout: 1500,
      headers: { 'User-Agent': 'Mozilla/5.0', 'Referer': 'https://gu.qq.com/' }
    })
    const klineData = JSON.parse(klineText)
    const stockData = klineData.data && klineData.data.sz399300
    const klines = (stockData && (stockData.qfqday || stockData.day)) || []
    if (klines.length < 20) return 'unknown'
    const closes = klines.map(k => parseFloat(k[2])).filter(c => c > 0)
    if (closes.length < 20) return 'unknown'
    const ma5 = closes.slice(-5).reduce((a, b) => a + b, 0) / 5
    const ma10 = closes.slice(-10).reduce((a, b) => a + b, 0) / 10
    const ma20 = closes.slice(-20).reduce((a, b) => a + b, 0) / 20
    const cur = closes[closes.length - 1]
    if (cur > ma5 && ma5 > ma10 && ma10 > ma20) return 'bull'
    if (cur < ma5 && ma5 < ma10 && ma10 < ma20) return 'bear'
    return 'range'
  }, 1500, 'unknown')
}

async function getMarketEnv() {
  // 并行获取行情和趋势
  const [quote, trend] = await Promise.all([
    getIndexQuote(),
    getIndexTrend(),
  ])

  if (!quote) {
    return { status: '未知', changePct: 0, trend: trend || 'unknown', volatility: 'normal', multiplier: 1.0, canPick: true }
  }

  // 计算乘数
  let multiplier = 1.0
  if (trend === 'bear') multiplier -= 0.4
  else if (trend === 'range') multiplier -= 0.15
  if (quote.status === '大跌') multiplier -= 0.3
  else if (quote.status === '下跌') multiplier -= 0.15
  else if (quote.status === '大涨') multiplier += 0.1
  multiplier = Math.max(0.3, Math.min(1.3, multiplier))

  // 多空判断
  let canPick = true
  if (trend === 'bear' && quote.status === '大跌') canPick = false
  if (trend === 'bear' && quote.status === '下跌') canPick = false
  if (quote.changePct < -3.0) canPick = false

  return {
    status: quote.status,
    changePct: quote.changePct,
    trend: trend || 'unknown',
    volatility: 'normal',
    multiplier: Math.round(multiplier * 100) / 100,
    canPick,
    current: quote.current,
    prevClose: quote.prevClose,
  }
}

exports.main = async (event, context) => {
  const { action } = event
  try {
    switch (action) {
      case 'get':
        return { success: true, data: await getMarketEnv() }
      default:
        return { success: false, error: '未知操作' }
    }
  } catch (err) {
    console.error('marketEnv error:', err)
    return { success: false, error: err.message }
  }
}