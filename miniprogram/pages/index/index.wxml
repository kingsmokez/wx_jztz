<!--pages/index/index.wxml-->
<wxs src="../../utils/format.wxs" module="fmt" />
<view class="page-container">
  <view class="hero-section">
    <view class="hero-badge"><text class="hero-badge-text">选股引擎 V5.5</text></view>
    <view class="hero-title-wrap">
      <text class="hero-title">价值投资</text>
      <text class="hero-title">之王</text>
    </view>
    <view class="hero-subtitle" wx:if="{{marketEnv}}">
      <text>沪深300 {{fmt.changePct(marketEnv.changePct)}}% · {{marketEnv.status}}</text>
      <text class="hero-pink" wx:if="{{marketEnv.trend === 'bull'}}"> 牛市信号</text>
    </view>
    <view class="live-indicator">
      <view class="live-dot"></view>
      <view class="live-tag"><text class="live-tag-text">实时</text></view>
      <text class="live-text">数据驱动选股</text>
    </view>
  </view>
  <view class="nav-grid">
    <view class="nav-card nav-card-pink" bindtap="goAuction">
      <text class="nav-card-label">早盘竞价</text>
      <text class="nav-card-sub">9:15-9:25 高开量能筛选</text>
      <text class="nav-card-cta">→ {{auctionCount}}只入选</text>
    </view>
    <view class="nav-card nav-card-green" bindtap="goWp2">
      <text class="nav-card-label">尾盘强势</text>
      <text class="nav-card-sub">14:00 MA对齐+量能突破</text>
      <text class="nav-card-cta">→ {{wp2Count}}只入选</text>
    </view>
    <view class="nav-card nav-card-yellow" bindtap="goStrong">
      <text class="nav-card-label">短线强势</text>
      <text class="nav-card-sub">全天 技术面60%+基本面40%</text>
      <text class="nav-card-cta">→ {{strongCount}}只入选</text>
    </view>
  </view>
  <view class="section-header">
    <text class="section-icon">📊</text>
    <text class="section-label">评分模型</text>
  </view>
  <view class="factor-card">
    <view class="factor-row"><text class="factor-name">价值因子</text><view class="factor-bar"><view class="factor-fill" style="width: 36%"></view></view><text class="factor-pct">36%</text></view>
    <view class="factor-row"><text class="factor-name">情绪因子</text><view class="factor-bar"><view class="factor-fill" style="width: 33%"></view></view><text class="factor-pct">33%</text></view>
    <view class="factor-row"><text class="factor-name">动量因子</text><view class="factor-bar"><view class="factor-fill" style="width: 12%"></view></view><text class="factor-pct">12%</text></view>
    <view class="factor-row"><text class="factor-name">质量因子</text><view class="factor-bar"><view class="factor-fill" style="width: 11%"></view></view><text class="factor-pct">11%</text></view>
    <view class="factor-row"><text class="factor-name">成长因子</text><view class="factor-bar"><view class="factor-fill" style="width: 8%"></view></view><text class="factor-pct">8%</text></view>
  </view>
  <view class="disclaimer-bar">
    <text class="disclaimer-text">⚠ 本系统选股结果仅供参考，不构成投资建议</text>
  </view>
</view>