/* pages/index/index.wxss — Loot Drop Brutalist 风格 */
page { background: var(--bg); }
.page-container { min-height: 100vh; }

/* Hero 区域 — 黄色英雄区 (参考 loot-drop-clone) */
.hero-section {
  background: var(--accent);
  padding: var(--space-6) var(--space-5) var(--space-5);
  border-bottom: 3px solid var(--border);
  margin-bottom: var(--space-5);
}
.hero-badge { display: inline-block; margin-bottom: var(--space-3); }
.hero-badge-text { font-size: 10px; font-weight: 800; background: var(--loot-dark); color: #FFFFFF; padding: 4px 10px; border: 2px solid var(--border); display: inline-block; font-family: var(--font-mono); }
.hero-title-wrap { margin-bottom: var(--space-3); }
.hero-title { font-size: 48px; font-weight: 900; color: var(--loot-dark); line-height: 1.1; display: block; letter-spacing: -1px; }
.hero-subtitle { font-size: 14px; color: var(--loot-dark); margin-bottom: var(--space-3); font-weight: 600; }
.hero-pink { color: var(--pink); font-weight: 800; }
.live-indicator { display: flex; align-items: center; gap: var(--space-3); }
.live-dot { width: 8px; height: 8px; background: var(--loot-green); border-radius: 50%; }
.live-tag { padding: 2px 6px; background: var(--loot-dark); border: 2px solid var(--border); }
.live-tag-text { font-size: 9px; font-weight: 800; color: #FFFFFF; }
.live-text { font-size: 11px; color: var(--loot-dark); font-weight: 700; }

/* 导航卡片网格 */
.nav-grid { padding: 0 var(--space-5); display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-5); }
.nav-card { padding: var(--space-5); border: 3px solid var(--border); display: flex; flex-direction: column; }
.nav-card:active { opacity: 0.85; }
.nav-card-pink { background: var(--pink); color: var(--loot-dark); }
.nav-card-green { background: var(--loot-green); color: var(--loot-dark); }
.nav-card-yellow { background: var(--accent); color: var(--loot-dark); }
.nav-card-label { font-size: 18px; font-weight: 900; }
.nav-card-sub { font-size: 11px; font-weight: 400; margin-top: 6px; }
.nav-card-cta { font-size: 11px; font-weight: 700; font-family: var(--font-mono); margin-top: 10px; }

/* 评分模型区域 */
.section-header { display: flex; align-items: center; gap: var(--space-3); padding: 0 var(--space-5) var(--space-3); }
.section-icon { font-size: 14px; }
.section-label { font-size: 11px; font-weight: 800; color: var(--fg-2); font-family: var(--font-mono); }
.factor-card { margin: 0 var(--space-5) var(--space-5); background: var(--surface); border: 3px solid var(--border); padding: var(--space-4); }
.factor-row { display: flex; align-items: center; gap: var(--space-3); margin-bottom: 8px; }
.factor-row:last-child { margin-bottom: 0; }
.factor-name { width: 60px; font-size: 11px; font-weight: 700; color: var(--fg-2); }
.factor-bar { flex: 1; height: 14px; background: var(--surface-2); border: 2px solid var(--border); overflow: hidden; }
.factor-fill { height: 100%; background: var(--accent); transition: width 0.5s; }
.factor-pct { width: 30px; font-size: 12px; font-weight: 900; text-align: right; font-family: var(--font-mono); }

/* 免责声明 */
.disclaimer-bar { padding: var(--space-4) var(--space-5); text-align: center; }
.disclaimer-text { font-size: 10px; color: var(--fg-3); font-weight: 600; }