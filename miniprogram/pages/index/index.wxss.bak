/* 首页 — Loot Drop 严格配色 */
page { background: var(--bg); }
.page-container { min-height: 100vh; padding-bottom: 60px; }

/* 英雄区 — 黄色背景（完全按参考设计） */
.hero-section { background: var(--accent); padding: 36px 16px 24px; position: relative; margin-bottom: 0; }
.hero-badge { display: inline-block; background: var(--dark); padding: 4px 12px; margin-bottom: var(--space-3); }
.hero-badge-text { font-size: 9px; font-weight: 900; color: #fff; letter-spacing: 1px; }
.hero-title-wrap { margin-bottom: var(--space-3); }
.hero-title { display: block; font-size: 36px; font-weight: 900; line-height: 1.0; color: var(--fg); letter-spacing: -1px; }
.hero-subtitle { font-size: 13px; color: var(--dark-2); margin-bottom: var(--space-3); }
.hero-pink { color: var(--pink); font-weight: 700; }
.live-indicator { display: flex; align-items: center; gap: var(--space-2); }
.live-dot { width: 6px; height: 6px; background: var(--loot-green); border-radius: 50%; }
.live-tag { background: #fff; padding: 2px 6px; border: 2px solid var(--border); }
.live-tag-text { font-size: 8px; font-weight: 900; color: var(--fg); letter-spacing: 1px; }
.live-text { font-size: 10px; font-weight: 700; color: var(--fg-2); }

.nav-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
.nav-card { padding: 14px 16px; border-bottom: 3px solid var(--border); position: relative; }
.nav-card:active { opacity: 0.85; }
.nav-card-pink { background: var(--pink); color: #fff; }
.nav-card-green { background: var(--loot-green); color: #fff; }
.nav-card-yellow { background: var(--accent); color: var(--fg); }
.nav-card-label { display: block; font-size: 18px; font-weight: 900; }
.nav-card-sub { display: block; font-size: 11px; margin-top: 2px; opacity: 0.8; }
.nav-card-cta { display: block; font-size: 11px; font-weight: 800; margin-top: var(--space-3); }

.section-header { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-4); background: #fff; border-bottom: 3px solid var(--border); margin-top: var(--space-3); }
.section-label { font-size: 11px; font-weight: 800; }

.factor-card { background: #fff; padding: var(--space-4); border-bottom: 3px solid var(--border); }
.factor-row { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); }
.factor-row:last-child { margin-bottom: 0; }
.factor-name { font-size: 11px; font-weight: 700; width: 50px; text-align: right; }
.factor-bar { flex: 1; height: 8px; background: var(--surface-2); border: 2px solid var(--border); }
.factor-fill { height: 100%; background: var(--accent); }
.factor-pct { font-size: 11px; font-weight: 700; width: 30px; font-family: var(--font-mono); }

.disclaimer-bar { background: var(--dark); padding: 8px 16px; }
.disclaimer-text { font-size: 9px; color: var(--fg-3); font-weight: 500; }
