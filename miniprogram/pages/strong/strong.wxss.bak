/* 短线强势股 — Loot Drop 严格配色 */
page { background: var(--bg); }
.page-container { min-height: 100vh; padding-bottom: 100rpx; }

.env-bar { display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-4); background: var(--dark); color: #fff; margin: var(--space-4); border: none; }
.env-label text { font-size: 10px; font-weight: 700; font-family: var(--font-mono); }
.env-pct { font-size: 18px; font-weight: 900; margin-left: var(--space-3); }
.env-status { font-size: 10px; padding: 2px 8px; background: rgba(255,255,255,0.15); font-weight: 700; }

.action-bar { display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-4); border-bottom: 3px solid var(--border); margin: 0 var(--space-4); margin-bottom: var(--space-4); }
.action-left { display: flex; align-items: baseline; gap: var(--space-3); }
.pick-title { font-size: 20px; font-weight: 900; color: var(--fg); }
.pick-time { font-size: 10px; color: var(--fg-2); font-family: var(--font-mono); }
.btn-refresh { background: var(--accent); border: 3px solid var(--border); padding: 6px 20px; font-size: 12px; font-weight: 900; color: var(--fg); }
.btn-refresh:active { background: var(--dark); color: #fff; }

.loading-wrap { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-spinner { width: 40rpx; height: 40rpx; border: 4px solid var(--border-light); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.6s linear infinite; }
.loading-text { margin-top: var(--space-4); color: var(--fg-2); font-size: 13px; font-weight: 700; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 150rpx 0; }
.empty-icon { font-size: 48px; margin-bottom: var(--space-4); }
.empty-title { font-size: 16px; font-weight: 900; color: var(--fg); }
.empty-desc { font-size: 12px; color: var(--fg-2); margin-top: var(--space-2); }

.stock-list { padding: 0 var(--space-4); }

.stats-row { display: flex; gap: 0; margin-bottom: var(--space-4); border: 3px solid var(--border); }
.stat-box { flex: 1; padding: 8px 10px; background: #fff; border-right: 1px solid var(--border); text-align: center; }
.stat-box:last-child { border-right: none; }
.stat-box .val { font-size: 16px; font-weight: 900; color: var(--fg); font-family: var(--font-mono); }
.stat-box .val.gold { color: #fff; background: var(--dark); display: inline-block; padding: 0 4px; }
.stat-box .val.green { color: var(--loot-green); }
.stat-box .lbl { font-size: 9px; color: var(--fg-2); margin-top: 2px; font-weight: 700; }

.stock-card { background: #fff; border: 3px solid var(--border); margin-bottom: var(--space-4); animation: fadeIn 0.2s ease; }
.stock-card:active { opacity: 0.9; }

.card-header { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; background: var(--accent); border-bottom: 3px solid var(--border); }
.card-rank { font-size: 14px; font-weight: 900; color: var(--fg); }
.card-signals { display: flex; flex-wrap: wrap; gap: 4px; justify-content: flex-end; }

.card-name-section { display: flex; justify-content: space-between; align-items: flex-start; padding: 8px 10px; border-bottom: 2px solid var(--border); }
.name-left { flex: 1; }
.stock-name { font-size: 16px; font-weight: 900; color: var(--fg); }
.stock-code { font-size: 10px; color: var(--fg-2); font-family: var(--font-mono); margin-left: 6px; }
.stock-industry { font-size: 9px; color: var(--fg-2); margin-top: 2px; display: block; }
.price-right { text-align: right; }
.stock-price { font-size: 18px; font-weight: 900; font-family: var(--font-mono); display: block; }
.stock-change { font-size: 12px; font-weight: 700; display: block; }

.metrics-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; border-bottom: 2px solid var(--border); }
.metric-cell { padding: 6px 6px; text-align: center; border-right: 1px solid var(--border-light); }
.metric-cell:last-child { border-right: none; }
.metric-label { font-size: 8px; color: var(--fg-3); font-weight: 700; display: block; text-transform: uppercase; }
.metric-value { font-size: 13px; font-weight: 900; color: var(--fg); font-family: var(--font-mono); display: block; margin-top: 1px; }

.score-row { display: flex; align-items: center; padding: 6px 10px; background: var(--surface-2); border-bottom: 2px solid var(--border); }
.score-label { font-size: 10px; font-weight: 700; color: var(--fg-2); width: 40px; }
.score-fill-bg { flex: 1; height: 12px; background: #fff; border: 2px solid var(--border); position: relative; }
.score-fill { height: 100%; background: var(--accent); }
.score-num { font-size: 14px; font-weight: 900; width: 36px; text-align: right; font-family: var(--font-mono); }

.buysell-row { display: flex; border-bottom: 2px solid var(--border); }
.bs-cell { flex: 1; text-align: center; padding: 6px 4px; border-right: 1px solid var(--border); }
.bs-cell:last-child { border-right: none; }
.bs-label { font-size: 8px; color: var(--fg-3); font-weight: 700; display: block; font-family: var(--font-mono); }
.bs-price { font-size: 13px; font-weight: 900; display: block; margin-top: 1px; font-family: var(--font-mono); }
.bs-buy { background: #E8F5E9; }
.bs-sell { background: #FFF8E1; }
.bs-stop { background: #FFEBEE; }
