/* pages/strong/strong.wxss — Loot Drop Brutalist 风格 */
page { background: var(--bg); }
.page-container { padding: var(--space-4); min-height: 100vh; }

/* 大盘环境栏 */
.env-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--space-3) var(--space-4);
  background: var(--surface); border: 3px solid var(--border);
  margin-bottom: var(--space-4);
}
.env-label { display: flex; align-items: center; gap: var(--space-3); }
.env-label text { font-size: 11px; font-weight: 800; color: var(--fg-2); font-family: var(--font-mono); }
.env-pct { font-size: 18px; font-weight: 900; font-family: var(--font-mono); }
.env-status { font-size: 10px; font-weight: 800; padding: 2px 10px; border: 2px solid var(--border); }

/* 操作栏 */
.action-bar {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: var(--space-4);
}
.action-left { display: flex; align-items: baseline; gap: var(--space-3); }
.pick-title { font-size: 20px; font-weight: 900; color: var(--fg); }
.pick-time { font-size: 10px; color: var(--fg-2); font-family: var(--font-mono); }
.btn-refresh {
  background: var(--accent); border: 3px solid var(--border);
  padding: 6px 20px; font-size: 12px; font-weight: 900; color: var(--loot-dark);
}
.btn-refresh:active { background: var(--loot-dark); color: #fff; }

/* 统计行 */
.stats-row { display: flex; gap: 6px; margin-bottom: var(--space-4); flex-wrap: wrap; }
.stat-box { flex: 1; min-width: 60px; text-align: center; padding: 8px 4px; background: var(--surface); border: 3px solid var(--border); }
.stat-box .val { font-size: 18px; font-weight: 900; display: block; font-family: var(--font-mono); }
.stat-box .val.gold { color: var(--loot-gold); }
.stat-box .val.green { color: var(--loot-green); }
.stat-box .lbl { font-size: 9px; color: var(--fg-2); font-weight: 700; }

/* 加载 */
.loading-wrap { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.loading-spinner { width: 40rpx; height: 40rpx; border: 4px solid var(--border-light); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.6s linear infinite; }
.loading-text { margin-top: var(--space-4); color: var(--fg-2); font-size: 13px; font-weight: 700; }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 150rpx 0; }
.empty-icon { font-size: 48px; margin-bottom: var(--space-4); }
.empty-title { font-size: 16px; font-weight: 900; color: var(--fg); }
.empty-desc { font-size: 12px; color: var(--fg-2); margin-top: var(--space-2); }

/* 股票列表 */
.stock-list { padding: 0 var(--space-4); }
.stock-card { background: var(--surface); border: 3px solid var(--border); margin-bottom: var(--space-4); animation: fadeIn 0.2s ease; }
.stock-card:active { opacity: 0.9; }

/* 卡片头部 */
.card-header { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; background: var(--accent); border-bottom: 3px solid var(--border); }
.card-rank { font-size: 14px; font-weight: 900; color: var(--loot-dark); }
.card-rank-row { display: flex; align-items: center; gap: 8px; }
.card-rec-tag {
  font-size: 11px; font-weight: 800; padding: 1px 6px;
  border: 2px solid var(--border);
  display: inline-block;
  line-height: 1.4;
}
.card-rec-tag.rec-strong {
  font-size: 11px !important; padding: 1px 6px !important;
  background: linear-gradient(135deg, #FF6B00, #FF4081);
  color: #FFFFFF !important;
  border-color: var(--border) !important;
  animation: none !important;
  letter-spacing: 0 !important;
}
.card-rec-tag.rec-buy {
  font-size: 11px !important; padding: 1px 6px !important;
  background: var(--loot-green);
  color: #FFFFFF !important;
  border-color: var(--border) !important;
}
.card-rec-tag.rec-watch {
  font-size: 10px !important; padding: 1px 6px !important;
  background: var(--loot-blue);
  color: #FFFFFF !important;
  border-color: var(--border) !important;
}
.card-rec-tag.rec-caution {
  font-size: 10px !important; padding: 1px 6px !important;
  background: var(--surface-2);
  color: var(--fg) !important;
  border-color: var(--border-light) !important;
}
.card-signals { display: flex; flex-wrap: wrap; gap: 3px; justify-content: flex-end; }

/* 名称区域 */
.card-name-section { display: flex; justify-content: space-between; align-items: flex-start; padding: 8px 10px; border-bottom: 2px solid var(--border); }
.name-left { display: flex; flex-direction: column; }
.stock-name { font-size: 16px; font-weight: 900; color: var(--fg); }
.name-row-wrap { display: flex; align-items: center; gap: 8px; }
.stock-code { font-size: 10px; color: var(--fg-2); font-family: var(--font-mono); margin-top: 1px; }
.stock-industry { font-size: 9px; color: var(--fg-2); margin-top: 2px; font-weight: 700; }
.price-right { text-align: right; }
.stock-price { font-size: 18px; font-weight: 900; display: block; font-family: var(--font-mono); }
.stock-change { font-size: 12px; font-weight: 700; display: block; }

/* 指标网格 */
.metrics-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; border-bottom: 2px solid var(--border); }
.metric-cell { text-align: center; padding: 6px 4px; border-right: 1px solid var(--border-light); }
.metric-cell:last-child { border-right: none; }
.metric-label { font-size: 8px; color: var(--fg-3); font-weight: 700; display: block; }
.metric-value { font-size: 13px; font-weight: 900; display: block; margin-top: 1px; font-family: var(--font-mono); }

/* 详情区域 */
.detail-section { padding: 8px 10px; border-bottom: 2px solid var(--border); }
.detail-section-title { font-size: 10px; font-weight: 800; margin-bottom: 6px; display: block; }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; }
.detail-item { display: flex; flex-direction: column; }
.detail-label { font-size: 8px; color: var(--fg-3); font-weight: 700; }
.detail-value { font-size: 13px; font-weight: 900; margin-top: 2px; font-family: var(--font-mono); }

/* 评分行 */
.score-row { display: flex; align-items: center; gap: 8px; padding: 4px 10px; border-bottom: 2px solid var(--border); }
.score-row:last-child { border-bottom: none; }
.score-label { width: 50px; font-size: 10px; font-weight: 700; color: var(--fg-2); }
.score-fill-bg { flex: 1; height: 12px; background: var(--surface-2); border: 2px solid var(--border); overflow: hidden; }
.score-fill { height: 100%; background: var(--accent); transition: width 0.3s; }
.score-num { width: 36px; font-size: 14px; font-weight: 900; text-align: right; font-family: var(--font-mono); }

/* 买卖建议 */
.buysell-row { display: flex; border-top: 2px solid var(--border); }
.bs-cell { flex: 1; text-align: center; padding: 6px 4px; border-right: 1px solid var(--border); }
.bs-cell:last-child { border-right: none; }
.bs-label { font-size: 8px; color: var(--fg-3); font-weight: 700; display: block; font-family: var(--font-mono); }
.bs-price { font-size: 13px; font-weight: 900; display: block; margin-top: 1px; font-family: var(--font-mono); }
.bs-buy { background: #E8F5E9; }
.bs-sell { background: #FFF8E1; }
.bs-stop { background: #FFEBEE; }

