/* 我的页面 — Loot Drop Brutalist 配色 */
page { background: var(--bg); }
.page-container { min-height: 100vh; padding-bottom: 60px; }

.mine-header { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-6) var(--space-4); background: var(--loot-dark); color: #fff; }
.avatar-block { width: 48px; height: 48px; background: var(--accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 3px solid #fff; }
.avatar-text { font-size: 18px; font-weight: 900; color: var(--loot-dark); }
.user-info { flex: 1; }
.user-name { font-size: 14px; font-weight: 900; color: #fff; display: block; }
.user-id { font-size: 11px; color: var(--fg-3); display: block; margin-top: 2px; }
.pro-badge { background: var(--accent); padding: 3px 8px; }
.pro-text { font-size: 9px; font-weight: 900; letter-spacing: 1px; color: var(--loot-dark); }

.stats-row { display: flex; border-bottom: 3px solid var(--border); }
.stats-item { flex: 1; display: flex; flex-direction: column; align-items: center; padding: var(--space-4) 0; background: #fff; border-right: 1px solid var(--border); }
.stats-item:last-child { border-right: none; }
.stats-num { font-size: 24px; font-weight: 900; line-height: 1; color: var(--fg); font-family: var(--font-mono); }
.stats-label { font-size: 9px; color: var(--fg-2); font-weight: 700; margin-top: 4px; }

.section-header { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-4); background: #fff; border-bottom: 3px solid var(--border); margin-top: var(--space-3); }
.section-label { font-size: 11px; font-weight: 800; }

.info-list { background: #fff; border-bottom: 3px solid var(--border); }
.info-row { display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border-light); }
.info-row:last-child { border-bottom: none; }
.info-row:active { background: var(--surface-2); }
.info-label { font-size: 12px; font-weight: 700; color: var(--fg); }
.info-value { font-size: 12px; color: var(--fg-2); }
.info-value.link { color: var(--loot-blue); font-weight: 700; }

.factor-desc { padding: var(--space-3) var(--space-4); background: #fff; font-size: 11px; color: var(--fg-2); line-height: 1.6; border-bottom: 3px solid var(--border); }

.factor-visual { display: flex; justify-content: space-around; align-items: flex-end; height: 80px; padding: var(--space-4); background: #fff; border-bottom: 3px solid var(--border); }
.fv-item { display: flex; flex-direction: column; align-items: center; gap: 4px; flex: 1; }
.fv-bar { width: 20px; background: var(--surface-2); position: relative; overflow: hidden; border: 2px solid var(--border); }
.fv-fill { position: absolute; bottom: 0; left: 0; right: 0; background: var(--accent); }
.fv-opacity-85 { opacity: 0.85; }
.fv-opacity-60 { opacity: 0.6; }
.fv-opacity-50 { opacity: 0.5; }
.fv-opacity-35 { opacity: 0.35; }
.fv-label { font-size: 9px; font-weight: 700; color: var(--fg-2); }
.fv-pct { font-size: 9px; color: var(--fg-3); }

.disclaimer-bar { background: var(--loot-dark); padding: var(--space-3) var(--space-4); }
.disclaimer-text { font-size: 9px; color: var(--fg-3); font-weight: 500; }