/* ===== Loot Drop Brutalist — 严格按参考设计配色 ===== */
/* 参考 D:\UI\AIWebsiteCloner\webUI\loot-drop-clone */

page {
  --bg: #FAFAFA;
  --surface: #FFFFFF;
  --surface-2: #F5F5F5;
  --surface-3: #EEEEEE;
  --fg: #0A0A0A;
  --fg-2: #888888;
  --fg-3: #CCCCCC;
  --muted: #888888;
  --border: #0A0A0A;
  --border-light: #DDDDDD;
  --accent: #FFD600;
  --accent-2: #EAB308;
  --accent-dim: #FFF8E1;
  --pink: #FF4081;
  --green: #00C853;
  --blue: #2979FF;
  --dark: #1A1A1A;
  --dark-2: #333333;
  --dark-light: #555555;
  --red: #7F1D1D;
  --orange: #FF6B00;
  --amber: #F59E0B;
  --loot-yellow: #FFD600;
  --loot-pink: #FF4081;
  --loot-green: #00C853;
  --loot-blue: #2979FF;
  --loot-amber: #F59E0B;
  --loot-dark: #1A1A1A;
  --loot-red: #7F1D1D;
  --loot-orange: #FF6B00;

  --font-body: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-mono: "SF Mono", "Roboto Mono", ui-monospace, Menlo, Consolas, monospace;
  --radius: 0px;
  --space-1: 2px;
  --space-2: 4px;
  --space-3: 8px;
  --space-4: 12px;
  --space-5: 16px;
  --space-6: 20px;

  background: var(--bg);
  font-family: var(--font-body);
  color: var(--fg);
  -webkit-font-smoothing: antialiased;
}

.price-up, .up { color: var(--pink) !important; }
.price-down, .down { color: var(--green) !important; }
.price-flat { color: var(--fg-2) !important; }

@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
@keyframes bar-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

::-webkit-scrollbar { width: 0; height: 0; }

.rec-strong { color: var(--fg); font-weight: 900; }
.rec-buy { color: var(--loot-green); font-weight: 800; }
.rec-watch { color: var(--loot-blue); }
.rec-caution { color: var(--fg-3); }

.sig {
  font-size: 9px; padding: 2px 6px; font-weight: 800;
  border: 2px solid var(--border); display: inline-block;
}
.sig-pullback { background: var(--loot-green); color: #fff; border-color: var(--dark); }
.sig-break { background: var(--accent); color: var(--fg); border-color: var(--dark); }
.sig-cross { background: var(--loot-amber); color: var(--fg); border-color: var(--dark); }
.sig-gentle { background: #E8F5E9; color: #2E7D32; border-color: #2E7D32; }
.sig-moderate { background: #FFF8E1; color: #F57F17; border-color: #F57F17; }
.sig-extreme { background: #FFEBEE; color: #C62828; border-color: #C62828; }
.sig-strong { background: var(--pink); color: #fff; border-color: var(--dark); }
.sig-risk { background: var(--dark); color: #fff; border-color: var(--dark); }
.sig-oversold { background: var(--loot-blue); color: #fff; border-color: var(--dark); }
.sig-overbought { background: #FFF3E0; color: #E65100; border-color: #E65100; }
.sig-pe { background: #E8F5E9; color: #1B5E20; border-color: #1B5E20; }
.sig-roe { background: var(--loot-green); color: #fff; border-color: var(--dark); }

.brutal-card { background: var(--surface); border: 3px solid var(--border); margin-bottom: var(--space-5); }
.brutal-btn { background: var(--accent); border: 3px solid var(--border); color: var(--fg); font-weight: 900; font-size: 12px; padding: 6px 20px; display: inline-block; }
.brutal-btn:active { background: var(--dark); color: #fff; }
.brutal-tag { border: 2px solid var(--border); padding: 2px 8px; font-size: 10px; font-weight: 800; }
